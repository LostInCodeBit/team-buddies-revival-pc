* text=auto
# Windows scripts keep CRLF (cmd misreads labels and long lines in LF batch files)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.rc text eol=crlf
# shell scripts keep LF (sh stops at a CR), also in a Windows checkout built from WSL
*.sh text eol=lf
*.png binary
*.ico binary
*.dll binary
*.lib binary
